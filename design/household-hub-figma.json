  "styles": {
    "color": {
      "primary": "#4F8EF7",
      "accent": "#34C759",
      "background": "#F5F7FA",
      "card": "#FFFFFF",
      "textPrimary": "#1C1C1E",
      "textSecondary": "#6B7280"
