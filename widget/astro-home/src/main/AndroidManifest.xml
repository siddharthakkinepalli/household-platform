<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Widget receiver is declared here so it merges into the host app's manifest.
        The android:resource must point to an appwidget-provider XML in the host app's res/xml/.
        Create android/src/main/res/xml/astro_widget_info.xml with the widget dimensions.
    -->
    <application>
        <receiver
            android:name=".AstroWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/astro_widget_info" />
        </receiver>

        <receiver
            android:name=".background.AstroWidgetUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jugaad.astro.action.UPDATE_WIDGET" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
